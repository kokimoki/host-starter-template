{
	"name": "@kokimoki/host-starter",
	"private": true,
	"version": "1.1.6",
	"type": "module",
	"description": "A starter template for building a host-based games using Kokimoki SDK",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite --clearScreen false",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "tsc -b",
		"build": "npm run lint && npm run typecheck && vite build",
		"preview": "vite preview",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@kokimoki/app": "^3.2.0",
		"@kokimoki/react-components": "^2.0.0",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.2.3",
		"class-variance-authority": "^0.7.1",
		"i18next": "^25.8.0",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^16.5.3",
		"react-markdown": "^10.1.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@kokimoki/kit": "^1.8.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"eslint-plugin-valtio": "^0.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^6.3.3",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0"
	}
}
